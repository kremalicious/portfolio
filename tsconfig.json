{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@content/*": ["./src/_content/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["astro/client", "@types/bun"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "coverage", "node_modules"]
}
