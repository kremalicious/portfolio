---
import styles from './HostnameCheck.module.css'

interface Props {
  allowedHosts: string[]
}

const { allowedHosts } = Astro.props
---
<aside class={`${styles.hostnameInfo} hostnameInfo`} style="display: none;">
  <p>
    {`Hi there 👋. Please note that only the code and documentation of this
          site are open source. But my logo and the combination of typography,
          colors, and layout making up my brand identity are not. Don't just
          clone, do a remix.`}
  </p>
</aside>

<script define:vars={{ allowedHosts }}>
const isAllowedHost = allowedHosts.includes(window.location.hostname)

if (!isAllowedHost) {
  const aside = document.querySelector('aside.hostnameInfo')
  if (aside) aside.style.display = 'block'
}
</script>
