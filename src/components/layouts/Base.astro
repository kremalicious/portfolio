---
import '@/styles/global.css'
import meta from '@content/meta.json'
import FooterComponent from '@/components/common/Footer/Footer.astro'
import HeadComponent from '@/components/common/Head.astro'
import HostnameCheck from '@/components/common/HostnameCheck/HostnameCheck.astro'
---
<html lang="en">
  <HeadComponent/>

  <body>
    <HostnameCheck allowedHosts={meta.allowedHosts}/>

    <main class="screen">
      <slot/>
    </main>
    <FooterComponent/>
  </body>
</html>

<style>
.screen {
  margin: 0 auto;
  padding-left: 5vw;
  padding-right: 5vw;
}

@media (min-width: 55rem) {
  .screen {
    max-width: calc(var(--projectImageMaxWidth) + 10vw);
  }
}
</style>
