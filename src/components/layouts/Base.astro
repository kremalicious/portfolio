---
  import '@/styles/global.css'
  import meta from '@content/meta.json'
  import FooterComponent from '@/components/common/Footer/Footer.astro'
  import HeadComponent from '@/components/common/Head.astro'
  import HeaderComponent from '@/components/common/Header/Header.astro'
  import HostnameCheck from '@/components/common/HostnameCheck/HostnameCheck.astro'
  import ThemeSwitch from '@/features/theme-switch/components/ThemeSwitch.astro'

  type Props = {
    title?: string
    description?: string
    image?: ImageMetadata
    noHeader?: boolean
  }

  const { noHeader = false, title, description, image } = Astro.props
---
<html lang="en">
  <HeadComponent title={title} description={description} image={image}/>

  <body>
    <HostnameCheck allowedHosts={meta.allowedHosts}/>
    <ThemeSwitch/>

    {!noHeader && <HeaderComponent/>}

    <main class="container">
      <slot/>
    </main>

    <FooterComponent/>
  </body>
</html>
