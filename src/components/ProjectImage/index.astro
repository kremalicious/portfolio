---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import styles from './index.module.css'

type Props = {
  image: ImageMetadata
  alt: string
  sizes: string
  className?: string
  priority?: boolean
}

const { image, alt, sizes, className, priority } = Astro.props as Props
if (!image || !image.src) return null
---

<figure class={`${styles.imageWrap} ${className || null}`}>
      <Image
        class={styles.image}
        src={image.src}
        alt={alt}
        width={image.width}
        height={image.height}
        sizes={sizes}
        quality={85}
        priority={priority}
      />
    </figure>
