---
import { Font, getImage } from 'astro:assets'
import meta from '@content/meta.json'
import { getCanonicalUrl } from '@/lib/canonical-url'
import { metaDescriptionMaxLength } from '@/lib/meta-description'
import type { StructuredData } from '@/lib/structured-data'

// import faviconSrc from '@/images/favicon.png'
// import faviconSvgSrc from '@/images/favicon.svg'

type Props = {
  title?: string
  description?: string
  image?: ImageMetadata
  structuredData?: StructuredData
  noindex?: boolean
}

const {
  title,
  description,
  image,
  structuredData,
  noindex = false
} = Astro.props
const { name, label } = meta.author

const titleFinal =
  title && title !== ''
    ? `${title} // ${name.toLowerCase()}`
    : `${name.toLowerCase()} { ${label.toLowerCase()} }`

function truncateDescription(text: string) {
  const normalized = text.replace(/\s+/g, ' ').trim()
  if (normalized.length <= metaDescriptionMaxLength) return normalized

  const cut = normalized.slice(0, metaDescriptionMaxLength - 1)
  const lastSpace = cut.lastIndexOf(' ')
  const words = lastSpace > 0 ? cut.slice(0, lastSpace) : cut
  return `${words.replace(/[\s.,;:–—-]+$/, '')}…`
}

const descriptionFinal = truncateDescription(description ?? meta.description)

const canonicalUrl = Astro.site
  ? getCanonicalUrl(Astro.url.pathname, Astro.site)
  : undefined
const robotsContent = noindex ? 'noindex, noai, noimageai' : 'noai, noimageai'

const imageFinal = `${Astro.site?.origin}${
  image
    ? (await getImage({ src: image, width: 800, format: 'jpg' })).src
    : meta.img
}`

const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
  : undefined

const imageFinalAlt = image ? `Teaser image for ${title}` : 'Logo'
const isProduction = process.env.NODE_ENV === 'production'
const { UMAMI_WEBSITE_ID, UMAMI_SCRIPT_URL } = process.env
const shouldIncludeAnalytics =
  isProduction && UMAMI_WEBSITE_ID && UMAMI_SCRIPT_URL
---

<head>
  <meta charset="utf-8">

  <script is:inline>
    function setInitialTheme() {
      const colors = { dark: '#1d2224', light: '#e7eef4' }
      const preferredTheme = sessionStorage.getItem('preferred-theme')
      const systemPrefersDark = window?.matchMedia(
        '(prefers-color-scheme: dark)'
      ).matches
      let theme = 'light'

      if (preferredTheme === 'dark' || preferredTheme === 'light') {
        theme = preferredTheme
      } else if (systemPrefersDark) {
        theme = 'dark'
      }

      const root = document.documentElement
      const meta = document.querySelector('meta[name="theme-color"]')
      const color = colors[theme]

      root.setAttribute('data-theme', theme)
      root.setAttribute('data-theme-color', color)
      meta?.setAttribute('content', color)
    }

    setInitialTheme()
  </script>

  <title>{titleFinal}</title>

  {!noindex && canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
  <meta name="description" content={descriptionFinal}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={name}>
  <meta property="og:title" content={titleFinal}>
  <meta property="og:description" content={descriptionFinal}>
  <meta property="og:image" content={imageFinal}>
  <meta property="og:image:alt" content={imageFinalAlt}>
  {!noindex && canonicalUrl && <meta property="og:url" content={canonicalUrl}>}
  <meta name="twitter:card" content="summary_large_image">

  <meta name="theme-color" content="#e7eef4">
  <meta name="color-scheme" content="light dark">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, shrink-to-fit=no"
  >
  <meta name="robots" content={robotsContent}>

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">

  <link rel="sitemap" href="/sitemap-index.xml">

  {structuredDataJson && (
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  )}

  <Font cssVariable="--font-ff-tisa-sans-pro" />
  <Font cssVariable="--font-brandon-grotesque" />

  {shouldIncludeAnalytics && (
    <>
      <link rel="preconnect" href={UMAMI_SCRIPT_URL} />
      <script
        async
        src={UMAMI_SCRIPT_URL}
        data-website-id={UMAMI_WEBSITE_ID}
        is:inline
      />
    </>
  )}
</head>
