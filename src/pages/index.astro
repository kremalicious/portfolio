---
import Hero from '@/components/common/Hero/Hero.astro'
import BaseLayout from '@/components/layouts/Base.astro'
import Projects from '@/features/projects/components/Projects/Projects.astro'
import { getProjects } from '@/features/projects/lib/get-projects'

import Repositories from '@/features/repositories/components/Repositories.astro'
import { getRepos } from '@/features/repositories/lib/get-repos'
import { getHomeStructuredData } from '@/lib/structured-data'

const repos = await getRepos()
const projects = await getProjects()
---

<BaseLayout noHeader structuredData={getHomeStructuredData()}>
  <Hero />
  <Projects projects={projects} />
  <Repositories repos={repos} />
</BaseLayout>
