---
import Hero from '@/components/Hero/Hero.astro'
import BaseLayout from '@/components/layouts/Base/Base.astro'
import Projects from '@/features/projects/components/Projects/index.astro'
import { getProjects } from '@/features/projects/lib/get-projects'
import Repositories from '@/features/repositories/components/Repositories.astro'
import { getRepos } from '@/features/repositories/lib/get-repos'

const repos = await getRepos()
const projects = await getProjects()
---
<BaseLayout>
  <Hero/>
  <Projects projects={projects}/>
  <Repositories repos={repos}/>
</BaseLayout>
