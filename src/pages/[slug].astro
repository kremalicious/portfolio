---
import HeaderComponent from '@/components/Header'
import Project from '@/components/Project'
import styles from '@/components/Project/index.module.css'
import ProjectImage from '@/components/ProjectImage/index.astro'
import ProjectNav from '@/components/ProjectNav/index.astro'
import BaseLayout from '@/layouts/Base.astro'
import { getProjectBySlug } from '@/lib/get-project-by-slug'
import { getProjects } from '@/lib/get-projects'

type Props = {
  params: { slug: string }
}

const { slug } = Astro.props.params
const project = await getProjectBySlug(slug)
if (!project) return Astro.redirect('/404')

const projects = await getProjects()
---
<BaseLayout
  title={project.title}
  description={`${project.description.slice(0, 157)}...`}
  image={project.images[0]}
>
  <HeaderComponent/>
  <Project project={project} client:load></Project>
  <ProjectNav projects={projects} currentSlug={slug}/>
</BaseLayout>
