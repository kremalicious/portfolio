---
import HeaderComponent from '@/components/common/Header/Header.astro'
import BaseLayout from '@/components/layouts/Base.astro'
import styles from '@/components/Project/index.module.css'
import Project from '@/features/projects/components/Project/Project.astro'
import ProjectImage from '@/features/projects/components/ProjectImage/index.astro'
import ProjectNav from '@/features/projects/components/ProjectNav/index.astro'
import { getProjectBySlug } from '@/features/projects/lib/get-project-by-slug'
import { getProjects } from '@/features/projects/lib/get-projects'

export async function getStaticPaths() {
  const projects = await getProjects()
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }))
}

const { slug } = Astro.params
const { project } = Astro.props
const projects = await getProjects()
---
<BaseLayout
  title={project.title}
  description={`${project.description.slice(0, 157)}...`}
>
  <HeaderComponent/>
  <Project project={project}/>
  <ProjectNav projects={projects} currentSlug={slug}/>
</BaseLayout>
