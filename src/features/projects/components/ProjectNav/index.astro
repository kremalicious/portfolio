---
import type { ProjectType } from '../../types/project'
import styles from './index.module.css'
import Project from './Project.astro'

type Props = {
  projects: ProjectType[]
  currentSlug: string
}

const { projects, currentSlug } = Astro.props
---
<nav class={styles.projectNav} id="project-nav">
  {projects.map((project: ProjectType) => (
    <Project
      project={project}
      isCurrent={project.slug === currentSlug}
    />
  ))}
</nav>

<script>
function scrollToCurrent() {
  const scrollContainer = document.getElementById('project-nav')
  const currentItem = scrollContainer?.querySelector(
    '[data-current="true"]'
  ) as HTMLElement

  if (!scrollContainer || !currentItem) return

  const scrollRect = scrollContainer.getBoundingClientRect()
  const activeRect = currentItem.getBoundingClientRect()

  if (!activeRect || !scrollRect) return

  const newScrollLeftPosition =
    activeRect.left -
    scrollRect.left -
    scrollRect.width / 2 +
    activeRect.width / 2

  scrollContainer.scrollLeft += newScrollLeftPosition
}

// Run on page load
scrollToCurrent()

// Run after view transitions
document.addEventListener('astro:page-load', scrollToCurrent)
</script>
