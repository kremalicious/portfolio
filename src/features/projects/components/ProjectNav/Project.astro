---
  import ProjectImage from '@/features/projects/components/ProjectImage/index.astro'
  import type { ProjectType } from '../../types/project'
  import styles from './index.module.css'

  type Props = {
    project: ProjectType
    isCurrent?: boolean
  }

  const { project, isCurrent } = Astro.props
---
<a
  class={`${styles.item} ${isCurrent ? styles.current : ''}`}
  href={`/${project.slug}`}
  title={project.title}
  data-current={isCurrent ? 'true' : undefined}
>
  <ProjectImage
    image={project.images[0]}
    alt={project.title}
    className={styles.projectImage}
    width={884}
  />

  <span>{project.title}</span>
</a>
