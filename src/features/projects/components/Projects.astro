---
import type { ProjectType } from '../types/project'
import ProjectPreview from './ProjectPreview/index.astro'

type Props = {
  projects: ProjectType[]
}

const { projects } = Astro.props
---
<nav class="projects">
  {projects.length > 0 &&
    projects.map((project) => (
      <ProjectPreview
        title={project.title}
        slug={project.slug}
        images={project.images}
      />
    ))}
</nav>

<style>
.projects {
  display: grid;
  gap: var(--space-xl);
}

@media (min-width: 55rem) {
  .projects {
    gap: var(--space-2xl);
    grid-template-columns: repeat(
        auto-fill,
        minmax(min-content, calc(50% - var(--space-l)))
      );
  }
}
</style>
