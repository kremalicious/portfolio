---
  import { Image } from 'astro:assets'
  import type { ProjectImage } from '../../types/project'
  import styles from './ProjectImage.module.css'

  type Props = {
    image: ProjectImage
    alt: string
    className?: string
    width?: number
  }

  const { image, alt, className, width } = Astro.props as Props
  if (!image) return null

  const defaultSizes = '(min-width: 960px) 2400px, 100vw'
  const widths = [400, 400 * 2, 800, 800 * 2, 1200, 1200 * 2]
---
<figure
  class:list={[styles.imageWrap, className || '']}
  style={`--image-background-color: ${image.dominantColor}`}
>
  <Image
    class={styles.image}
    src={image}
    alt={alt}
    width={width}
    widths={widths}
    sizes={defaultSizes}
    loading="lazy"
    decoding="async"
    onload={`this.style.opacity='1'`}
  />
</figure>
