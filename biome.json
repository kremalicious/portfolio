{
  "extends": ["@kremalicious/config/biome"],
  "linter": {
    "domains": {
      "next": "none"
    },
    "rules": {
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "indentScriptAndStyle": true
    }
  },
  "markdown": {
    "formatter": {
      "formatEmbeds": false
    },
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**/*.yml", "src/**/*.yml"],
      "yaml": {
        "formatter": {
          "quoteStyle": "single"
        }
      }
    }
  ]
}
