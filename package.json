{
  "name": "@kremalicious/portfolio",
  "description": "Portfolio thingy",
  "version": "1.0.0",
  "homepage": "https://matthiaskretschmann.com",
  "repository": "github:kremalicious/portfolio",
  "license": "MIT",
  "author": "Matthias Kretschmann <m@kretschmann.io>",
  "type": "module",
  "scripts": {
    "dev": "bun run prebuild && bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "jest": "jest --coverage -c tests/jest.config.js",
    "test": "NODE_ENV=test bun run jest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && bun --bun astro check",
    "new": "bun ./scripts/new.ts",
    "favicon": "bun ./scripts/favicon.ts",
    "prebuild": "bun ./scripts/prebuild.ts"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "5.7.0",
    "@radix-ui/react-select": "2.2.5",
    "@yaireo/relative-time": "1.0.5",
    "file-saver": "2.0.5",
    "lucide-react": "0.526.0",
    "motion": "12.23.9",
    "next": "15.4.4",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-html": "16.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@kremalicious/config": "2.2.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.3.1",
    "@types/file-saver": "2.0.7",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.9.1",
    "chalk": "5.4.1",
    "jest": "30.0.5",
    "jest-environment-jsdom": "30.0.5",
    "jest-fetch-mock": "3.0.3",
    "js-yaml": "4.1.0",
    "ora": "8.2.0",
    "sharp": "0.34.1",
    "sharp-ico": "0.1.5",
    "slugify": "1.6.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "browserslist": ["> 0.2%", "last 3 versions", "Firefox ESR", "not dead"]
}
